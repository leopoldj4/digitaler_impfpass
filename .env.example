# ── Convex self-hosted backend ────────────────────────────────────────────────
# A human-readable name for the Convex deployment (safe default: impfpass).
INSTANCE_NAME=impfpass

# 32-byte random secret used to derive the admin key and sign tokens.
# Generate with:  openssl rand -hex 32
# Must be exactly 64 hex characters. CHANGE THIS before any non-local deployment.
INSTANCE_SECRET=

# ── Data Acquisition service ──────────────────────────────────────────────────
# URL of the llama.cpp-compatible LLM inference server used for image extraction.
# The data-acquisition container calls this URL at /v1/chat/completions.
LLAMA_CPP_BASE_URL=http://rcbe-srv-012.hs-regensburg.de:49068
