# Data Acquisition Service (LLM API Configuration)
LLAMA_CPP_BASE_URL=http://rcbe-srv-012.hs-regensburg.de:49068
GEMMA_API_KEY=
GEMMA_API_BASE=

# Frontend Configuration
# All Convex calls are browser-side, so localhost:3210 (the host-exposed port) is correct.
# Do NOT use host.docker.internal — the browser cannot resolve it, causing CORS errors.
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211

# Convex Action Configuration (set on the HOST before running npm run convex-dev)
# Convex actions run on the host machine, so they reach the data-acquisition container
# via its host-mapped port. start-convex.sh exports this automatically.
EXTRACTOR_BASE_URL=http://localhost:8000
